{
  "contract_id": "ahos.ai_council",
  "version": "v1",
  "created_utc": "2026-08-13T01:59:23+00:00",
  "law": "the council is ADVISORY ONLY. No averaging, no blind majority vote, no invented consensus. Consensus is NOT truth: agreement is reported with evidence overlap, not promoted. INSUFFICIENT_EVIDENCE wins when evidence is thin.",
  "protocol_stages": ["problem_intake", "diagnostic_classification", "routing",
                      "independent_responses", "evidence_validation", "disagreement_analysis",
                      "red_team", "proposal"],
  "council_verdicts": ["CONSENSUS", "DISAGREEMENT", "INSUFFICIENT_EVIDENCE", "NEEDS_MORE_DATA"],
  "redteam_verdicts": ["REJECT", "INVALID", "INSUFFICIENT_EVIDENCE", "NEEDS_MORE_DATA"],
  "report_fields": {
    "report_id": "string",
    "artifact_ref": "string (sha/id of analyzed artifact)",
    "task_class": "enum capabilities of ai_provider_contract_v1",
    "provider_responses": "array of ai_provider response envelopes (validated)",
    "deterministic_checks": "array of {check_id, verdict, evidence}",
    "agreement_matrix": "pairwise categorical agreement, per claim key; numbers NEVER averaged",
    "evidence_overlap": "shared evidence_refs across providers",
    "evidence_conflicts": "claims citing contradictory evidence",
    "provider_health": "snapshot of router health/circuit per provider",
    "redteam": "array of {target, verdict(redteam_verdicts), probe_id, reason}",
    "verdict": "enum council_verdicts",
    "advisory_only": "constant true",
    "unresolved_questions": "array",
    "version": "string",
    "timestamp": "number epoch"
  },
  "ai_may": ["critique", "classify", "summarize", "propose hypotheses", "identify contradictions",
             "suggest code improvements", "propose tests", "identify missing evidence",
             "diagnose", "analyze failures", "suggest architecture"],
  "ai_may_not": ["declare economic truth", "create authoritative market numbers", "overwrite evidence",
                 "bypass security", "bypass risk", "execute trades", "modify frozen governance",
                 "promote own proposal", "silently change AHOS", "self-approve own code"],
  "offline_law": "no available provider => council verdict INSUFFICIENT_EVIDENCE with council_status=OFFLINE and deterministic floor ACTIVE"
}
