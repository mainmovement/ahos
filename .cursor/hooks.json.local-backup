{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": ".venv\\Scripts\\python.exe .cursor/hooks/ahos-guard.py preToolUse",
        "matcher": "Write|Delete|StrReplace",
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".venv\\Scripts\\python.exe .cursor/hooks/ahos-guard.py beforeShellExecution",
        "failClosed": true
      }
    ]
  }
}

