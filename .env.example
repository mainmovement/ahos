# ==============================================================================
# AHOS — configuration
#
#   cp .env.example .env      (Windows:  copy .env.example .env)
#
# Classification of keys:
#   REQUIRED for Telegram bot process: TELEGRAM_BOT_TOKEN
#   REQUIRED for One-Brain G2 gateway PASS: DATABASE_URL (+ npm run dev)
#   REQUIRED for calibration-eligible local evidence: AHOS_EVIDENCE_SOURCE=local
#   STRONGLY RECOMMENDED: AHOS_PAPER_ONLY=1, TELEGRAM_ALLOWED_CHAT_IDS
#   OPTIONAL: paid AI / CMC / DEXTools keys (system stays deterministic without them)
#
# NEVER commit .env — it is gitignored.
# NEVER set AHOS_ALLOW_REAL_FUNDS / AHOS_EXECUTE_LIVE_TRADES (security veto).
# ==============================================================================

# ---- Safety (operator contract) ----------------------------------------------
# Keep PAPER_ONLY. Live-trading flags are vetoed by assert_safe_environment().
AHOS_PAPER_ONLY=1
# Forbidden (must stay unset/false):
# AHOS_ALLOW_REAL_FUNDS=0
# AHOS_EXECUTE_LIVE_TRADES=0

# ---- Self-evolution human gate ----------------------------------------------
# Comma-separated human approver ids required to advance proposals to APPROVED.
# Without this (and without the unbound escape hatch), approvals fail closed.
AHOS_HUMAN_APPROVER_IDS=
# Local/test escape hatch only — never set to 1 on production soak hosts.
AHOS_ALLOW_UNBOUND_HUMAN_APPROVAL=0


# ---- Telegram (required to run the bot) --------------------------------------
# Get one from @BotFather on Telegram: /newbot
TELEGRAM_BOT_TOKEN=

# Restrict the bot to your own chat. Find your id by messaging @userinfobot.
# REQUIRED for production: empty allowlist is FAIL-CLOSED (nobody authorized)
# unless AHOS_TELEGRAM_ALLOW_OPEN_ACCESS=1 is set deliberately for local mock use.
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ADMIN_USER_IDS=
# Local/dev only. Never enable on a reachable production bot.
AHOS_TELEGRAM_ALLOW_OPEN_ACCESS=0

# Max messages per second per user.
TELEGRAM_RATE_LIMIT_RPS=1.0


# ---- Iran / filtering --------------------------------------------------------
# api.telegram.org and most data providers are filtered. Point this at your
# local tunnel and every outbound request in AHOS will honour it.
# Examples:
#   ALL_PROXY=socks5://127.0.0.1:10808     (v2ray / xray default)
#   ALL_PROXY=socks5://127.0.0.1:9050      (Tor)
#   ALL_PROXY=http://127.0.0.1:8080        (HTTP proxy)
ALL_PROXY=
HTTPS_PROXY=


# ---- AI council (ALL OPTIONAL) -----------------------------------------------
# With zero keys the council reports OFFLINE and the deterministic engine keeps
# running. It never blocks a decision. Add keys only if you want AI opinions.
#
# Ollama — free, local, immune to filtering. Install from ollama.com, then:
#   ollama pull qwen2.5:7b-instruct
# The AI router reads OLLAMA_API_URL (legacy spelling OLLAMA_BASE_URL is
# ignored — kept in docs only for older setups).
OLLAMA_API_URL=http://127.0.0.1:11434

# Free-tier cloud models (all optional, all have generous free quotas):
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GITHUB_TOKEN=

# Paid providers. Left blank on purpose: the project holds a $0 cost floor and
# these are not reachable from Iran without a foreign card anyway.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
NVIDIA_API_KEY=
# Paid Gemini tier (declared-paid slot in config/ai_provider_registry.yaml);
# the free GEMINI_API_KEY above is a separate registry entry.
GEMINI_API_KEY_PAID=


# ---- Market data providers (ALL OPTIONAL) ------------------------------------
# DexScreener, GeckoTerminal, GoPlus and RugCheck need no key and are the
# default sources. DEXTools has no free tier, so it stays disabled unless you
# buy a key; without it AHOS reports NO_KEY and carries on.
DEXTOOLS_API_KEY=

# CoinMarketCap free tier (pro-api.coinmarketcap.com) also requires a key.
# Same inert-until-configured contract as DEXTools: without a key the adapter
# reports NO_KEY and never sends traffic; with a key it enriches market cap /
# FDV / volume / price-change for indexed addresses. Get one free at
# https://pro.coinmarketcap.com/signup (free plan).
COINMARKETCAP_API_KEY=

# CoinGecko has a keyless public API; an optional demo key raises the rate
# ceiling (never required, never sent when blank):
# https://www.coingecko.com/en/developers/dashboard
COINGECKO_API_KEY=


# ---- Telegram Conversation Gateway (W57) ------------------------------------
# Telegram must NOT score independently. Point this at the Web One-Brain chat API.
# Empty value BLOCKS G2 (operator gate treats empty-but-set as misconfig).
# Without a working URL, Telegram replies EMERGENCY_FALLBACK_ONLY (honest; no fake scores).
AHOS_GATEWAY_URL=http://127.0.0.1:3000/api/chat

# ---- Lane-B Web API auth (fail-closed, mirrors Telegram allowlist) ------------
# All /api/* routes require this token unless open access is explicitly enabled.
# Generate once (PowerShell): [guid]::NewGuid().ToString("N") + [guid]::NewGuid().ToString("N")
# Set BOTH to the same value so Command Center (browser) and Telegram gateway match.
AHOS_WEB_API_TOKEN=
NEXT_PUBLIC_AHOS_WEB_API_TOKEN=
# Local/mock only. Never enable on a LAN-reachable Next process.
AHOS_WEB_API_ALLOW_OPEN_ACCESS=0

# ---- One-Brain / Next.js (required for G2 gateway PASS) ----------------------
# conversationGateway reads Postgres via drizzle. Without DATABASE_URL, /api/chat
# returns HTTP 500 even when `npm run dev` is listening.
# Must match Docker ahos_postgres_win (deployment/docker-compose.windows.yml):
#   DATABASE_URL=postgresql://ahos_user:YOUR_PASSWORD@127.0.0.1:5432/ahos
# drizzle-kit (drizzle.config.ts) reads the same DATABASE_URL — never app_db.
# npm run dev / start bind to 127.0.0.1 (not 0.0.0.0).
DATABASE_URL=


# ---- Narrative / evidence (integration) --------------------------------------
# Pipeline orchestrator defaults to fetching RSS once per cycle when unset/1.
# Set to 0 for offline/air-gapped runs (narrative atoms become UNKNOWN).
AHOS_NARRATIVE_FETCH=1
# Score ledger namespace: only `local` is calibration-eligible.
#   AHOS_EVIDENCE_SOURCE=local
AHOS_EVIDENCE_SOURCE=


# ---- Web alert engine (optional tuning) --------------------------------------
# Used by root alerts.ts / Command Center paper alerts. Defaults are safe.
AHOS_ALERT_COOLDOWN_SEC=900
AHOS_ALERT_SCORE_FLOOR=0.72
# Optional override for alert state JSON path (default: reports/pump_alert_state.json)
AHOS_ALERT_STATE=


# ---- Runtime -----------------------------------------------------------------
# Chain and cycle cadence are runtime CLI arguments (--chain, --interval-sec,
# --daemon) — see `python -m architecture.runtime --help`. No env keys are
# read for them (removed here after the CLI became the canonical surface).
