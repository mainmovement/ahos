# paths.yaml is machine-local (generated by `python config/paths.py` or the
# Windows installer into reports/paths_local_*.yaml). It must not be committed:
# it embeds absolute host paths. Runtime code uses config.paths getters, not
# this file.
platform_detected: EXAMPLE
is_windows: false
project_root: /path/to/ahos
data_dir: /path/to/ahos/data
config_dir: /path/to/ahos/config
reports_dir: /path/to/ahos/reports
docs_dir: /path/to/ahos/docs
contracts_dir: /path/to/ahos/contracts
n8n_workflows_dir: /path/to/ahos/n8n/workflows
databases:
  discovery: /path/to/ahos/data/e01_discovery.sqlite
  paper_trading: /path/to/ahos/data/paper_trading.sqlite
  local: /path/to/ahos/data/ahos_local.sqlite
  knowledge: /path/to/ahos/data/ahos_knowledge.sqlite
