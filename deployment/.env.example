# AHOS Production Environment Variables Template
# COPY THIS FILE TO .env AND FILL IN YOUR SECURE CREDENTIALS.
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL.

# Runtime Configuration
AHOS_ENV=production
AHOS_PORT=8000
AHOS_LOG_LEVEL=INFO

# Telegram Bot Interface (Edge Layer)
# Format: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz1234567
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
# Allowed Telegram Chat IDs (comma-separated integers)
TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321
# Admin User IDs
# Prefer root .env.example key TELEGRAM_ADMIN_USER_IDS (canonical).
TELEGRAM_ADMIN_USERS=123456789
TELEGRAM_ADMIN_USER_IDS=
AHOS_TELEGRAM_ALLOW_OPEN_ACCESS=0

# Lane-B Next /api/* fail-closed gate (must match Command Center public token)
AHOS_WEB_API_TOKEN=
NEXT_PUBLIC_AHOS_WEB_API_TOKEN=
AHOS_WEB_API_ALLOW_OPEN_ACCESS=0
AHOS_GATEWAY_URL=http://127.0.0.1:3000/api/chat

# AI Layer Configuration ($0 Ceiling - Free/Keyless/Local by Default)
# Optional: Set these only if using personal free-tier accounts
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Invariants - DO NOT CHANGE
# Real trading is strictly prohibited by law.
AHOS_PAPER_ONLY=1
