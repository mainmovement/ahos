{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "plugins": [{ "name": "next" }],
    "typeRoots": ["./node_modules/@types", "./types"]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "vendor_assets",
    "docs/archive",
    "01",
    "advanced-3d-audiovisual-website",
    "advanced-3d-audiovisual-website (1)",
    "سایت درختadvanced-3d-audiovisual-platform",
    "درخت کاملتر immersive-3d-audiovisual-website",
    "**/*.test.tsx",
    "**/*.test.ts",
    "app/command_center/components/app-sidebar.tsx",
    "app/command_center/components/config-drawer.tsx",
    "app/command_center/components/data-table",
    "app/command_center/components/dashboard/components",
    "app/command_center/components/dashboard/template-dashboard.tsx",
    "app/command_center/components/dashboard/index.tsx",
    "app/command_center/components/kbar",
    "app/command_center/components/themes",
    "app/command_center/components/stage",
    "app/command_center/components/shell",
    "app/command_center/components/modal",
    "app/command_center/components/password-input.test.tsx",
    "app/command_center/app",
    "app/components"
  ]
}
