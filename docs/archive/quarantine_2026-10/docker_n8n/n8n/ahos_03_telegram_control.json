    {
      "parameters": {
        "jsCode": "// Agent-04 Security: admin auth BEFORE any action. Never log tokens.\nconst msg = $json.message || {};\nconst chatId = msg.chat && msg.chat.id;\nconst admin = String($env.TELEGRAM_ADMIN_CHAT_ID || '');\nconst text = (msg.text || '').trim();\nconst authorized = admin !== '' && String(chatId) === admin;\nlet type = 'UNKNOWN', arg = null, raw = null;\nconst m = text.match(/^\\/(start|status|report|risk|signals|health|agents|kill|emergency_stop|reset|approve|reject)\\b\\s*(\\S+)?/i);\nif (m) { raw = m[1].toLowerCase(); arg = m[2] || null;\n  if (['start','status','report','risk','signals'].includes(raw)) type = 'READ';\n  else if (raw === 'health') type = 'HEALTH';\n  else if (raw === 'agents') type = 'AGENTS';\n  else if (['kill','emergency_stop'].includes(raw)) type = 'KILL';\n  else if (raw === 'reset') type = 'RESET';\n  else type = raw === 'approve' ? 'APPROVE' : 'REJECT';\n}\nreturn [{ json: { authorized, type, arg, chatId, raw_cmd: raw } }];"
      },
