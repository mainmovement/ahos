        "jsCode": "\n// Error Handler\nconst data = $input.first().json;\nreturn [{ json: {\n  error_caught: true,\n  workflow: 'MAIN_TOKEN_INTELLIGENCE_ENGINE',\n  error: data.error || 'Unknown',\n  node: data.node || 'Unknown',\n  timestamp: new Date().toISOString()\n}}];\n"
