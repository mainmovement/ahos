    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO tokens (contract, symbol, name, chain, first_seen_at) VALUES ('{{$json.contract}}', '{{$json.symbol}}', '{{$json.name}}', 'solana', NOW()) ON CONFLICT (contract) DO NOTHING;"
      },
