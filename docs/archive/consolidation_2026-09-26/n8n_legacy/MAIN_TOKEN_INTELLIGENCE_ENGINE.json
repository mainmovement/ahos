      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\n// A13: Daily Self-Learning\nconst learner = require('/home/user/ahos_engine/agents/team13_self_learner.js').learner;\ntry {\n  const insight = learner.analyze_and_adapt();\n  const status = learner.get_status();\n  return [{ json: {\n    insight: insight || 'No insight (insufficient data)',\n    status: status,\n    timestamp: new Date().toISOString()\n  }}];\n} catch (error) {\n  return [{ json: { error: error.message } }];\n}\n"
      },
