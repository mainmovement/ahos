# Windows .bat launchers must keep CRLF in the GIT BLOB.
#
# raw.githubusercontent.com serves the blob as stored. With `text eol=crlf`,
# git normalizes to LF in the repo, so `curl` downloads are LF-only and
# cmd.exe mis-parses multi-line if/pause blocks.
#
# `-text` disables normalization so we can store CRLF for curl + double-click.
*.bat -text
*.cmd -text

# PowerShell tolerates LF from raw; keep working-tree CRLF on Windows checkout.
*.ps1 text eol=crlf

# Everything else keeps LF in the repository.
*.py  text eol=lf
*.sh  text eol=lf
*.md  text eol=lf
*.sql text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
