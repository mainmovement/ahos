# Windows launchers: .bat keep working-tree CRLF via eol=crlf (existing blobs are LF).
# .cmd entry points used with curl raw.githubusercontent.com must be -text with CRLF
# stored in the git blob (otherwise cmd.exe mis-parses LF-only downloads).
*.bat text eol=crlf
*.cmd -text
*.ps1 text eol=crlf

# Everything else keeps LF in the repository.
*.py  text eol=lf
*.sh  text eol=lf
*.md  text eol=lf
*.sql text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
